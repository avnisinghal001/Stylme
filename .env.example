# StylMe single local environment source for frontend, backend, and data tools.
# Copy this file to .env at the repository root. Never commit real values.
# Vercel projects must define the same keys in Project Settings because the
# ignored root .env is intentionally not uploaded during deployment.

# MongoDB Atlas (backend runtime + data seeders)
MONGODB_URL=
MONGODB_DB_NAME=StylMe

# Temporary cross-cluster migration target. Leave blank for normal installs.
# When present, the runtime prefers it so cutover can be tested before replacing
# MONGODB_URL. Never commit a populated URI.
MIGRATE_DESTINATION_MONGO_URI=

# FastAPI application defaults
APP_NAME=StylMe API
API_VERSION=v1
DEBUG=true
MONGO_ENSURE_INDEXES_ON_STARTUP=false
CORS_ORIGINS=http://localhost:3000,https://fitstylme.vercel.app,https://stylme-swoopstyl.vercel.app

# Server-only authentication/bootstrap values. Generate a long JWT secret and
# a bcrypt owner password hash; never store the owner's plaintext password.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=720
OWNER_EMAIL=
OWNER_PASSWORD_HASH=
OWNER_FULL_NAME=StylMe Owner

# Server-only secret used by a scheduler. External POST schedulers can use
# X-Cron-Secret; Vercel Cron sends it as Authorization: Bearer. Never place it
# in a URL or NEXT_PUBLIC variable.
CRON_SECRET=
STOREFRONT_URL=http://localhost:3000
CHECKOUT_RECOVERY_ENCRYPTION_KEY=
CHECKOUT_RECOVERY_LOCK_SECONDS=240
CHECKOUT_RECOVERY_HTTP_TIMEOUT_SECONDS=25

# Browser-direct API target. Include the /api/v1 prefix.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Hackathon-only direct browser media/AI mode. Every NEXT_PUBLIC value is
# extractable by users. Use disposable, quota-restricted keys and rotate them.
NEXT_PUBLIC_HACKATHON_DIRECT_AI=false
NEXT_PUBLIC_IMGBB_KEY=
NEXT_PUBLIC_GEMINI_API_KEYS=
NEXT_PUBLIC_AI_GEMINI_MODEL=gemini-3.1-flash-lite
NEXT_PUBLIC_OPENROUTER_API_KEYS=
NEXT_PUBLIC_AI_OPENROUTER_MODEL=google/gemini-2.5-flash

# Offline catalogue enrichment uses `codex login` + `codex exec`; no model API
# key is read from this file.

# StylMe Go AI control plane. The browser talks to this service for hero AI
# chat; the normal navbar search continues to call FastAPI directly.
GO_API_PORT=8081
GO_CORS_ORIGINS=http://localhost:3000,https://fitstylme.vercel.app,https://stylme-swoopstyl.vercel.app
PYTHON_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_AI_API_BASE_URL=http://localhost:8081/v1
AI_INTERNAL_API_KEY=
# Encrypts API keys saved from Agent Studio before they reach MongoDB. Use a
# separate long random value in production; JWT_SECRET is the local fallback.
CREDENTIAL_ENCRYPTION_KEY=
AI_OPENAI_MODEL=gpt-5.6-luna
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
TAXONOMY_RECONCILER_MODEL=gpt-5.6
TAXONOMY_RECONCILER_AUTO_APPLY_CONFIDENCE=0.94
TAXONOMY_RECONCILER_CRON_APPLY=false
TAXONOMY_RECONCILER_LOCK_SECONDS=900
TAXONOMY_RECONCILER_QUERY_RETENTION_DAYS=180
AI_SESSION_TTL=24h
SHUTDOWN_TIMEOUT=10s
CALL_WORKER_ENABLED=false
CALL_WORKER_INTERVAL=2s

# LiveKit Cloud voice worker. Keep provider keys server-side; never add a
# NEXT_PUBLIC prefix. AI_INTERNAL_API_KEY may reuse CRON_SECRET for local V1.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=stylme-voice
LIVEKIT_CONTROL_PLANE_URL=http://localhost:8081/v1
LIVEKIT_DEFAULT_INBOUND_SWARM_ID=swarm_default_inbound
LIVEKIT_DEFAULT_OUTBOUND_SWARM_ID=swarm_default_outbound
DEEPGRAM_API_KEY=
SARVAM_API_KEY=
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
VOICE_LANGUAGE=multi

# Twilio Elastic SIP Trunk inputs. A single purchased voice-capable number may
# be attached to the inbound termination URI and used as outbound caller ID.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_SIP_TRUNK_SID=
